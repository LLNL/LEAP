    x -= 0.5;
    y -= 0.5;
    z -= 0.5;

    int x0 = static_cast<int>(floor(x));
    int y0 = static_cast<int>(floor(y));
    int z0 = static_cast<int>(floor(z));

    float tx = x - x0;
    float ty = y - y0;
    float tz = z - z0;

    int x1 = x0 + 1;
    int y1 = y0 + 1;
    int z1 = z0 + 1;

    x0 = __MIN__(__MAX__(x0, 0), img_dim.x-1);
    x1 = __MIN__(__MAX__(x1, 0), img_dim.x-1);
    y0 = __MIN__(__MAX__(y0, 0), img_dim.y-1);
    y1 = __MIN__(__MAX__(y1, 0), img_dim.y-1);
    z0 = __MIN__(__MAX__(z0, 0), img_dim.z-1);
    z1 = __MIN__(__MAX__(z1, 0), img_dim.z-1);

    int d = img_dim.z;
    int dh = img_dim.y * img_dim.z;
    float c000 = ldg(&img[x0 * dh + y0 * d + z0]);
    float c100 = ldg(&img[x0 * dh + y0 * d + z1]);
    float c010 = ldg(&img[x0 * dh + y1 * d + z0]);
    float c110 = ldg(&img[x0 * dh + y1 * d + z1]);
    float c001 = ldg(&img[x1 * dh + y0 * d + z0]);
    float c101 = ldg(&img[x1 * dh + y0 * d + z1]);
    float c011 = ldg(&img[x1 * dh + y1 * d + z0]);
    float c111 = ldg(&img[x1 * dh + y1 * d + z1]);
    //#define IMG_IDX2(i,j,k) ((k)*img_dim.y*img_dim.z + (j)*img_dim.z + (i))
    //float c000 = ldg(&img[IMG_IDX2(iz,   iy,   ix  )]);
    //float c100 = ldg(&img[IMG_IDX2(iz+1, iy,   ix  )]);
    //float c010 = ldg(&img[IMG_IDX2(iz,   iy+1, ix  )]);
    //float c110 = ldg(&img[IMG_IDX2(iz+1, iy+1, ix  )]);
    //float c001 = ldg(&img[IMG_IDX2(iz,   iy,   ix+1)]);
    //float c101 = ldg(&img[IMG_IDX2(iz+1, iy,   ix+1)]);
    //float c011 = ldg(&img[IMG_IDX2(iz,   iy+1, ix+1)]);
    //float c111 = ldg(&img[IMG_IDX2(iz+1, iy+1, ix+1)]);

    // interpolate z-direction
    float c00 = fmaf(tz, c100-c000, c000); //c000 * (1 - tz) + c100 * tz;
    float c10 = fmaf(tz, c110-c010, c010); //c010 * (1 - tz) + c110 * tz;
    float c01 = fmaf(tz, c101-c001, c001); //c001 * (1 - tz) + c101 * tz;
    float c11 = fmaf(tz, c111-c011, c011); //c011 * (1 - tz) + c111 * tz;

    // interpolate y-direction
    float c0 = fmaf(ty, c10-c00, c00); //c00 * (1 - ty) + c10 * ty;
    float c1 = fmaf(ty, c11-c01, c01); //c01 * (1 - ty) + c11 * ty;

    // interpolate x-direction
    float result = fmaf(tx, c1-c0, c0); //c0 * (1 - tx) + c1 * tx;

    return result;

    #undef IMG_IDX2
}

__device__ inline float getTex3D_linear_clamp2(const float* img, int3 img_dim, float z, float y, float x)
{
    int4 img_dim2;
    img_dim2.x = img_dim.x; img_dim2.y = img_dim.y; img_dim2.z = img_dim.z;
    return getTex3D_linear_clamp2(img, img_dim2, z, y, x);
}

__device__ inline float getTex3D_linear1(const float* img, int4 img_dim, float x, float y, float z, bool clamp)
{
    if (clamp)
        return getTex3D_linear_clamp1(img, img_dim, x, y, z);
    else
        return getTex3D_linear_border1(img, img_dim, x, y, z);
}

