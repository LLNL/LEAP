__device__ inline float getTex3D_linear_clamp1(const float* img, int4 img_dim, float x, float y, float z)
{
    if (isnan(x) || isnan(y) || isnan(z))
        return 0;
    
    x -= 0.5;
    y -= 0.5;
    z -= 0.5;
    
    int x0 = static_cast<int>(floor(x));
    int y0 = static_cast<int>(floor(y));
    int z0 = static_cast<int>(floor(z));
    int x1 = x0 + 1;
    int y1 = y0 + 1;
    int z1 = z0 + 1;

    x0 = __MIN__(__MAX__(x0, 0), img_dim.x-1);
    x1 = __MIN__(__MAX__(x1, 0), img_dim.x-1);
    y0 = __MIN__(__MAX__(y0, 0), img_dim.y-1);
    y1 = __MIN__(__MAX__(y1, 0), img_dim.y-1);
    z0 = __MIN__(__MAX__(z0, 0), img_dim.z-1);
    z1 = __MIN__(__MAX__(z1, 0), img_dim.z-1);

    float tx = x - float(x);
    float ty = y - float(y);
    float tz = z - float(z);

    int w = img_dim.x;
    int wh = img_dim.y * img_dim.x;
    float c000 = ldg(&img[z0 * wh + y0 * w + x0]);
    float c100 = ldg(&img[z0 * wh + y0 * w + x1]);
    float c010 = ldg(&img[z0 * wh + y1 * w + x0]);
    float c110 = ldg(&img[z0 * wh + y1 * w + x1]);
    float c001 = ldg(&img[z1 * wh + y0 * w + x0]);
    float c101 = ldg(&img[z1 * wh + y0 * w + x1]);
    float c011 = ldg(&img[z1 * wh + y1 * w + x0]);
    float c111 = ldg(&img[z1 * wh + y1 * w + x1]);
    //#define IMG_IDX1(i,j,k) ((k)*img_dim.y*img_dim.x + (j)*img_dim.x + (i))
    //float c000 = ldg(&img[IMG_IDX1(ix,   iy,   iz  )]);
    //float c100 = ldg(&img[IMG_IDX1(ix+1, iy,   iz  )]);
    //float c010 = ldg(&img[IMG_IDX1(ix,   iy+1, iz  )]);
    //float c110 = ldg(&img[IMG_IDX1(ix+1, iy+1, iz  )]);
    //float c001 = ldg(&img[IMG_IDX1(ix,   iy,   iz+1)]);
    //float c101 = ldg(&img[IMG_IDX1(ix+1, iy,   iz+1)]);
    //float c011 = ldg(&img[IMG_IDX1(ix,   iy+1, iz+1)]);
    //float c111 = ldg(&img[IMG_IDX1(ix+1, iy+1, iz+1)]);

    // interpolate x-direction
    float c00 = fmaf(tx, c100-c000, c000); //c000 * (1 - tx) + c100 * tx;
    float c10 = fmaf(tx, c110-c010, c010); //c010 * (1 - tx) + c110 * tx;
    float c01 = fmaf(tx, c101-c001, c001); //c001 * (1 - tx) + c101 * tx;
    float c11 = fmaf(tx, c111-c011, c011); //c011 * (1 - tx) + c111 * tx;

    // interpolate y-direction
    float c0 = fmaf(ty, c10-c00, c00); //c00 * (1 - ty) + c10 * ty;
    float c1 = fmaf(ty, c11-c01, c01); //c01 * (1 - ty) + c11 * ty;

    // interpolate z-direction
    float result = fmaf(tz, c1-c0, c0); //c0 * (1 - tz) + c1 * tz;

    return result;

    #undef IMG_IDX1
}

