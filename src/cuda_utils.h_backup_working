//// 1D texture functions
__device__ inline float getTex1D_nearest_border(const float* img, int img_dim, float x)
{
    x -= 0.5;
    int x0 = static_cast<int>(x);
    if (x0 < 0 || x0 >= img_dim)
        return 0;
    
    float result = ldg(&img[x0]);
    return result;  
}

__device__ inline float getTex1D_nearest_clamp(const float* img, int img_dim, float x)
{
    ///x -= 0.5;
    int x0 = static_cast<int>(x);
    x0 = __MAX__(x0, 0);
    x0 = __MIN__(x0, img_dim-1);
    
    float result = ldg(&img[x0]);
    return result;  
}

__device__ inline float getTex1D_linear_border(const float* img, int img_dim, float x)
{
    if (isnan(x))
        return 0;

    x -= 0.5;
    if (x < 0 || x >= img_dim)
        return 0;
        
    int x0 = static_cast<int>(x);
    int x1 = __MIN__(x0+1, img_dim-1);
    float c0 = ldg(&img[x0]);
    float c1 = ldg(&img[x1]);
    if (x0 == x1) {
        return c0;
    }
    else {
        return c0 + ((x - x0) * (c1 - c0)) / (x1 - x0);
    }
}

__device__ inline float getTex1D_linear_clamp(const float* img, int img_dim, float x)
{
    if (isnan(x))
        return 0;

    ///x -= 0.5;
    int x0 = __MIN__(__MAX__(static_cast<int>(x), 0), img_dim-1);
    int x1 = __MIN__(x0+1, img_dim-1);
    float c0 = ldg(&img[x0]);
    float c1 = ldg(&img[x1]);
    if (x0 == x1) {
        return c0;
    }
    else {
        return c0 + ((x - x0) * (c1 - c0)) / (x1 - x0);
    }
}

