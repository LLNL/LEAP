__device__ inline float getTex3D_nearest_border1(const float* img, int4 img_dim, float x, float y, float z)
{
    x -= 0.5;
    y -= 0.5;
    z -= 0.5;

    int x0 = static_cast<int>(x);
    int y0 = static_cast<int>(y);
    int z0 = static_cast<int>(z);
    if (x0 < 0 || y0 < 0 || z0 < 0 || x0 >= img_dim.x || y0 >= img_dim.y || z0 >= img_dim.z)
        return 0;
    
    float result = ldg(&img[z0 * img_dim.y * img_dim.x + y0 * img_dim.x + x0]);
    return result;  
}

