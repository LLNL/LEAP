__device__ inline float getTex3D_linear_border1(const float* img, int4 img_dim, float x, float y, float z, bool verbose=false)
{
    if (isnan(x) || isnan(y) || isnan(z))
        return 0;
    
    x -= 0.5;
    y -= 0.5;
    z -= 0.5;
    //if (x < 0 || y < 0 || z < 0 || x >= img_dim.x || y >= img_dim.y || z >= img_dim.z)
    //if (x < 0 || y < 0 || z < 0 || x > img_dim.x-1 || y > img_dim.y-1 || z > img_dim.z-1)
    //if (x < 0 || y < 0 || z < 0 || x >= img_dim.x-1 || y >= img_dim.y-1 || z >= img_dim.z-1)
    //    return 0;

    int ix = floorf(x);
    int iy = floorf(y);
    int iz = floorf(z);
    if (ix < 0 || iy < 0 || iz < 0 || ix >= img_dim.x-1 || iy >= img_dim.y-1 || iz >= img_dim.z-1)
        return 0;

    float tx = x - ix;
    float ty = y - iy;
    float tz = z - iz;
    //if (verbose) {
    //    printf("verbose0: x0, y0, z0, x1, y1, z1 = %d, %d, %d, %d, %d, %d\n", x0, y0, z0, x1, y1, z1);
    //    printf("verbose0: tx, ty, tz = %f, %f, %f\n", tx, ty, tz);
    //}

    #define IMG_IDX1(i,j,k) ((k)*img_dim.y*img_dim.x + (j)*img_dim.x + (i))
    float c000 = ldg(&img[IMG_IDX1(ix,   iy,   iz  )]);
    float c100 = ldg(&img[IMG_IDX1(ix+1, iy,   iz  )]);
    float c010 = ldg(&img[IMG_IDX1(ix,   iy+1, iz  )]);
    float c110 = ldg(&img[IMG_IDX1(ix+1, iy+1, iz  )]);
    float c001 = ldg(&img[IMG_IDX1(ix,   iy,   iz+1)]);
    float c101 = ldg(&img[IMG_IDX1(ix+1, iy,   iz+1)]);
    float c011 = ldg(&img[IMG_IDX1(ix,   iy+1, iz+1)]);
    float c111 = ldg(&img[IMG_IDX1(ix+1, iy+1, iz+1)]);
    //if (verbose)
    //    printf("verbose1: %f, %f, %f, %f, %f, %f, %f, %f\n", c000, c100, c010, c110, c001, c101, c011, c111);

    // interpolate x-direction
    float c00 = c000 * (1 - tx) + c100 * tx; //fmaf(tx, c100-c000, c000);
    float c10 = c010 * (1 - tx) + c110 * tx; //fmaf(tx, c110-c010, c010);
    float c01 = c001 * (1 - tx) + c101 * tx; //fmaf(tx, c101-c001, c001);
    float c11 = c011 * (1 - tx) + c111 * tx; //fmaf(tx, c111-c011, c011); 
    //if (verbose)
    //    printf("verbose2: %f, %f, %f, %f\n", c00, c10, c01, c11);

    // interpolate y-direction
    float c0 = c00 * (1 - ty) + c10 * ty; //fmaf(ty, c10-c00, c00); 
    float c1 = c01 * (1 - ty) + c11 * ty; //fmaf(ty, c11-c01, c01); 
    //if (verbose)
    //    printf("verbose3: %f, %f\n", c0, c1);

    // interpolate z-direction
    float result = c0 * (1 - tz) + c1 * tz; //fmaf(tz, c1-c0, c0); 
    //if (verbose)
    //    printf("verbose4: %f\n", result);

    return result;

    #undef IMG_IDX
}

__device__ inline float getTex3D_linear_border1(const float* img, int3 img_dim, float x, float y, float z, bool verbose=false)
{
    int4 img_dim2;
    img_dim2.x = img_dim.x; img_dim2.y = img_dim.y; img_dim2.z = img_dim.z;
    return getTex3D_linear_border1(img, img_dim2, x, y, z, verbose);
}

